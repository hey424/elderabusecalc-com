{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elderabusecalc-com",
  "compatibility_date": "2026-05-18",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "main": "src/worker.ts",
  "routes": [
    {
      "pattern": "elderabusecalc.com/*",
      "zone_name": "elderabusecalc.com"
    },
    {
      "pattern": "www.elderabusecalc.com/*",
      "zone_name": "elderabusecalc.com"
    }
  ]
}
